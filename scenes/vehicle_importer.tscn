[gd_scene load_steps=2 format=3 uid="uid://bvehicleimport01"]

[ext_resource type="Script" path="res://scripts/ui/vehicle_importer.gd" id="1_importer"]

[node name="VehicleImporter" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_importer")

[node name="FileDialog" type="FileDialog" parent="."]
title = "选择3D模型文件"
size = Vector2i(700, 500)
filters = PackedStringArray("*.glb ; GLTF Binary", "*.gltf ; GLTF", "*.obj ; Wavefront OBJ", "*.dae ; Collada", "*.fbx ; FBX")
access = 0

[node name="Panel" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Scroll" type="ScrollContainer" parent="Panel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
offset_left = 10.0
offset_top = 10.0
offset_right = -10.0
offset_bottom = -10.0
horizontal_scroll_mode = 0

[node name="VBox" type="VBoxContainer" parent="Panel/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Panel/Scroll/VBox"]
layout_mode = 2
text = "导入载具资源"
